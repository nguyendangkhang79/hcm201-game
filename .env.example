# Server-only variables. Never prefix with VITE_ or commit real values.
# Create a private Upstash Redis database and copy its REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# At least 32 random characters. Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUIZ_SESSION_SECRET=
